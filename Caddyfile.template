# Caddy 리버스 프록시 설정 템플릿.
# 배포 스크립트(scripts/deploy.sh)가 아래 업스트림 placeholder 를 활성 색(app-blue:8080 /
# app-green:8080)으로 치환해 /opt/d14/Caddyfile 로 렌더링한 뒤 `caddy reload` 로 무중단 반영한다.
# 이 파일 자체를 직접 마운트하지 않는다 — 렌더링된 Caddyfile 을 마운트한다.
hilit.my {
	reverse_proxy __APP_UPSTREAM__ {
		# 전환/컨테이너 교체의 짧은 공백에 즉시 502 를 내지 않고 이 시간 동안 재시도해 흡수한다.
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
