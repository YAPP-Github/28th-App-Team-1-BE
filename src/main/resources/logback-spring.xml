<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot 기본 로그 패턴/색상 프로퍼티 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      로컬 개발(local 프로파일): 사람이 터미널에서 읽는 평문 콘솔.
      기본 활성 프로파일이 local 이므로 개발자는 별도 설정 없이 이 출력을 본다.
    -->
    <springProfile name="local">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

        <!--
          면접 수동 테스트 하네스(interview-harness)에서 세션 종료 후 sessionId로 로그를 추출해
          별도 파일로 뽑아볼 수 있도록, local 프로파일에 한해 콘솔과 동일한 로그를 logs/app.log 에도 남긴다.
          scripts/collect-interview-log.ps1 참고.
        -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/app.log</file>
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>7</maxHistory>
            </rollingPolicy>
        </appender>

        <!--
          면접 진행 중 캐물지점 풀/선택, 축 전환(예산 소진·천장 판정), 질문·답변 텍스트 같은
          내용성 로그는 DEBUG로 남긴다. 배포 환경(!local)은 root가 INFO 그대로라 영향 없다.
        -->
        <logger name="com.yapp.d14.interview" level="DEBUG"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!--
      배포 환경(local 이 아닌 모든 프로파일, 현재는 EC2 의 dev):
      컨테이너 stdout 으로 JSON 을 출력한다. docker awslogs 드라이버가 그대로 CloudWatch 로 전달하며,
      CloudWatch 는 level 등 필드 기반으로 검색/에러 필터링(Subscription Filter)을 할 수 있다.
      MDC 값(traceId/userId 등)은 LogstashEncoder 가 기본적으로 모두 포함한다.
    -->
    <springProfile name="!local">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
